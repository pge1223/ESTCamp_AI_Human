# ── NodeVelture backend .env (값 채워서 .env로 복사) ──────────────
# copy .env.example .env

# 데이터베이스
# [로컬 Docker] DATABASE_URL=postgresql+asyncpg://nodevelture:nodevelture@127.0.0.1:5433/nodevelture
# [Neon 클라우드] 아래처럼 붙여넣기 — ssl 처리는 database.py가 자동으로 해줌
DATABASE_URL=postgresql://user:pass@ep-xxx-yyy.us-east-2.aws.neon.tech/neondb?sslmode=require

# Redis (도커 / 또는 Upstash 클라우드 한 줄만)
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# ── AI 엔진 (정교 파이프라인) ─────────────────────────────────────
# 프로바이더 체인: 앞에서부터 시도, 소진/실패 시 다음으로 자동 승계
#   예) groq,gemini  /  openai,gemini  /  gemini
LLM_PROVIDER_CHAIN=groq,gemini

# 키는 콤마로 n개 (다른 계정일수록 무료 쿼터 합산 ↑). 429나면 다음 키/모델로 순환.
GROQ_API_KEY=          # gsk_... (console.groq.com, 무료 한도 넉넉)
GROQ_API_KEYS=         # gsk_1,gsk_2 (여러 개면)
GEMINI_API_KEY=        # AIzaSy... (aistudio.google.com)
GEMINI_API_KEYS=       # 키A,키B (여러 계정이면)
OPENAI_API_KEY=        # sk-... (체인에 openai 넣을 때)
OPENAI_API_KEYS=

# 모델 (필요 시 교체)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini

# 폴백 동작
LLM_KEY_COOLDOWN_SEC=600     # 429난 (키×모델) 스킵 시간
LLM_MAX_TRANSIENT_RETRY=2    # 일시 오류 재시도 횟수

# 보안 / 기타
SECRET_KEY=change-me-in-production
DEBUG=false
ALLOWED_ORIGINS=["*"]
